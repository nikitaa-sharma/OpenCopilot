# ==============================================================================
# OpenSource Copilot - Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the project root for Docker Compose or local dev.
# Never commit production secrets, tokens, or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Service Ports (Host bindings)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5432
OLLAMA_PORT=11434
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=opencopilot

# For Local Development outside Docker:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opencopilot
# Note: If host port 5432 is already occupied by a local PostgreSQL service (e.g. Windows service),
# set POSTGRES_PORT=5433 above and use port 5433 in DATABASE_URL.
# Inside Docker Compose, the backend automatically connects via container network:
# postgresql+asyncpg://postgres:postgres@postgres:5432/opencopilot

# ------------------------------------------------------------------------------
# GitHub API Integration
# ------------------------------------------------------------------------------
# Optional GitHub Personal Access Token (PAT) for higher rate limits (5,000 req/hr vs 60 req/hr)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT=15

# ------------------------------------------------------------------------------
# AI / LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: "ollama" (local), "openai", "groq"
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_API_KEY=

# Local development outside Docker:
LLM_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# For Docker Compose, the backend automatically connects to:
# http://ollama:11434

# ------------------------------------------------------------------------------
# Security & Authentication (JWT)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key for production: openssl rand -hex 32
AUTH_SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="OpenSource Copilot API"
API_V1_STR=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# RAG & Embeddings Pipeline (Local or Remote)
# ------------------------------------------------------------------------------
RAG_RETRIEVAL_MODE=vector
# Local dev: "sentence_transformers" (CPU, no API key needed)
# Vercel / Production: "openai" (remote, fast, lightweight serverless)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# ------------------------------------------------------------------------------
# Frontend Configuration (Browser-Accessible)
# ------------------------------------------------------------------------------
# For local dev: point to local backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# On Vercel: leave unset so it defaults to same-origin "/api"

# ------------------------------------------------------------------------------
# Vercel Production Deployment Reference
# ------------------------------------------------------------------------------
# When configuring environment variables in the Vercel Dashboard for Production,
# set the following variables:
#
# ENVIRONMENT=production
# AUTH_SECRET_KEY=<strong-random-32+-character-string>
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-or-supabase-host>:5432/<dbname>?ssl=require
# GITHUB_TOKEN=<optional-github-personal-access-token>
#
# Hosted LLM (OpenAI or Groq):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
#
# (Alternatively with Groq):
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...
#
# Remote Embeddings (OpenAI):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=384
# EMBEDDING_API_KEY=sk-...
#
# Security & Performance:
# CORS_ORIGINS=["https://<your-project>.vercel.app"]
# SKIP_DB_INIT=false

