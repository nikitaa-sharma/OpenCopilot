# ==============================================================================
# OpenSource Copilot - Backend Environment Configuration
# ==============================================================================

# Application
PROJECT_NAME="OpenSource Copilot API"
ENVIRONMENT=development
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000

# CORS settings (JSON list of origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# PostgreSQL Database
# Uses asyncpg driver for asynchronous database access
# (Use port 5433 if host port 5432 is occupied by a local PostgreSQL service)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opencopilot

# GitHub API Integration (Token is optional for public repos)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT=30

# AI / LLM Provider (Replaceable interface: "ollama", "openai", "anthropic", "local")
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REQUEST_TIMEOUT=120.0

# AI Context Building & Safety Limits
AI_MAX_CONTEXT_CHARS=60000
AI_MAX_FILES_IN_CONTEXT=15
AI_MAX_FILE_CHARS=6000

# RAG Pipeline Configuration (Phase 7 & 8)
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=150
RAG_MAX_CHUNKS_PER_FILE=100
RAG_MAX_TOTAL_CHUNKS=5000
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=12000
RAG_RETRIEVAL_MODE=vector

# Local Embeddings (Phase 8)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Authentication & Security (Phase 12)
AUTH_SECRET_KEY=dev-insecure-secret-key-change-in-production-min-32-chars-long
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080


